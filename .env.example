# Postgres (usado pelo docker-compose.yml)
POSTGRES_USER=praxis
POSTGRES_PASSWORD=praxis
POSTGRES_DB=praxis_diary
POSTGRES_PORT=5433

# Usado pelo Prisma para conectar ao banco acima
DATABASE_URL="postgresql://praxis:praxis@localhost:5433/praxis_diary?schema=public"

# NestJS
PORT=3000
NODE_ENV=development
