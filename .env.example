# Postgres (usado pelo docker-compose.yml)
POSTGRES_USER=praxis
POSTGRES_PASSWORD=praxis
POSTGRES_DB=praxis_diary
POSTGRES_PORT=5433

# Usado pelo Prisma para conectar ao banco acima
DATABASE_URL="postgresql://praxis:praxis@localhost:5433/praxis_diary?schema=public"

# NestJS
PORT=3000
NODE_ENV=development

# Logs (ver OBSERVABILITY.md). Vazio = debug em dev, info em produção.
# Valores: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=

# Métricas (ver ADR 0007). Com valor, GET /metrics exige
# `Authorization: Bearer <token>`. Vazio = aberto — aceitável em dev, NUNCA
# em produção. Gere com `openssl rand -hex 32`.
METRICS_TOKEN=

# JWT (gere valores próprios em cada ambiente, ex: `openssl rand -hex 32`)
JWT_ACCESS_SECRET=troque-por-um-valor-aleatorio-de-32-bytes
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=troque-por-outro-valor-aleatorio-de-32-bytes
JWT_REFRESH_EXPIRES_IN=7d

# CORS (ver ADR 0006). Lista separada por vírgula. Sem essa variável, libera
# qualquer origem — aceitável em dev, NUNCA em produção. Antes de qualquer
# deploy real, definir a(s) origem(ns) real(is) do frontend, ex:
# CORS_ALLOWED_ORIGINS=https://app.praxisdiary.com
CORS_ALLOWED_ORIGINS=

# Redis: storage compartilhado do rate limiting (ver ADR 0006) — necessário
# pra RNF06 (escalabilidade horizontal): contadores em memória não seriam
# compartilhados entre réplicas. Ajuste a porta se 6379 já estiver em uso.
REDIS_PORT=6379
REDIS_URL="redis://localhost:6379"

# Prometheus e Grafana (docker-compose.yml). Grafana na 3001 porque a 3000 é
# da API. Troque a senha do admin fora do ambiente local.
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
